#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;

=head1 NAME

report-missing - list albums from the iTunes catalog with tracks not on disk

=head1 SYNOPSIS

  report-missing --db catalog.sqlite --library mine --fallback jcap > missing.tsv

=head1 DESCRIPTION

Groups the audio tracks in C<itunes_track> into albums and, for each album,
counts how many tracks were matched to a file in the given library by
C<match-tracks>.  Albums with at least one unmatched track are printed, one
per line, as tab-separated columns:

  artist  album  present  missing  fallback

where C<fallback> is how many of the missing tracks were matched in the
C<--fallback> library instead.  Without C<--fallback> that column is
omitted.

Albums are as C<group-albums> decided them, which must have been run first.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s',       'the SQLite catalog',                     { required => 1 } ],
  [ 'library=s',  'the library that should hold the files', { required => 1 } ],
  [ 'fallback=s', 'a second library to check for missing tracks' ],
  [ 'all',        'include albums with nothing missing' ],
  [],
  [ 'help',       'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

binmode STDOUT, q{:encoding(UTF-8)};

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

my $rows = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} }, $opt->library, $opt->fallback // '');
  SELECT
    a.artist,
    a.album,
    COUNT(*) AS total,
    COUNT(m.file_id) AS present,
    SUM(CASE WHEN m.file_id IS NULL AND f.file_id IS NOT NULL THEN 1 ELSE 0 END) AS fallback
  FROM itunes_album a
  JOIN itunes_track_album ta ON ta.album_id = a.album_id
  LEFT JOIN itunes_track_file m ON m.track_id = ta.track_id AND m.library = ?
  LEFT JOIN itunes_track_file f ON f.track_id = ta.track_id AND f.library = ?
  GROUP BY a.album_id
  ORDER BY a.artist COLLATE NOCASE, a.album COLLATE NOCASE
  SQL

my ($albums, $missing_albums, $missing_tracks) = (0, 0, 0);

for my $row (@$rows) {
  $albums++;
  my $missing = $row->{total} - $row->{present};

  if ($missing) {
    $missing_albums++;
    $missing_tracks += $missing;
  } elsif (! $opt->all) {
    next;
  }

  say join "\t",
    $row->{artist}, $row->{album}, $row->{present}, $missing,
    ($opt->fallback ? $row->{fallback} : ());
}

printf STDERR "%d albums, %d with missing tracks, %d tracks missing\n",
  $albums, $missing_albums, $missing_tracks;
