#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;
use Unicode::Normalize qw(NFC);

=head1 NAME

group-albums - decide which catalog tracks make up which albums

=head1 SYNOPSIS

  group-albums --db catalog.sqlite

=head1 DESCRIPTION

iTunes filed each track under an artist, or under "Compilations" when its
compilation flag was set.  That flag was set inconsistently, so a tribute
album with sixteen artists and no flag looks like sixteen one-track albums,
and an album with the flag on half its tracks straddles two directories.

This program groups the catalog's audio tracks into albums the way a person
would, writes one row per album to C<itunes_album>, and links each track to
its album in C<itunes_track_album>.  Both tables are rebuilt on every run.

The rules, applied to all tracks sharing an album name:

=over

=item *

A track with no album name, or "Unknown Album", is an album by itself.

=item *

The group is a compilation if more than half its tracks are flagged as one,
or if some are flagged and its track numbers are all distinct, or if it
spans three or more artists with no album artist and its track numbers are
all distinct.  A compilation is one album filed under "Compilations".

=item *

Otherwise the group is split by album artist, or by artist where there is
none, and each part is an album.

=back

The "track numbers are all distinct" test is what keeps "Greatest Hits" by
forty artists from becoming one album.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s', 'the SQLite catalog', { required => 1 } ],
  [],
  [ 'help', 'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

$dbh->do('DROP TABLE IF EXISTS itunes_track_album');
$dbh->do('DROP TABLE IF EXISTS itunes_album');

$dbh->do(<<~'SQL');
  CREATE TABLE itunes_album (
    album_id    INTEGER NOT NULL PRIMARY KEY,
    artist      TEXT    NOT NULL,
    album       TEXT    NOT NULL,
    compilation INTEGER NOT NULL DEFAULT 0,
    singleton   INTEGER NOT NULL DEFAULT 0,
    tracks      INTEGER NOT NULL,
    track_total INTEGER,
    discs       INTEGER NOT NULL,
    disc_total  INTEGER
  )
  SQL

$dbh->do(<<~'SQL');
  CREATE TABLE itunes_track_album (
    track_id INTEGER NOT NULL PRIMARY KEY REFERENCES itunes_track (track_id),
    album_id INTEGER NOT NULL REFERENCES itunes_album (album_id)
  )
  SQL

$dbh->do('CREATE INDEX itunes_track_album_album ON itunes_track_album (album_id)');

my $tracks = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} });
  SELECT track_id, artist, album_artist, album, compilation,
         disc_number, disc_count, track_number, track_count
  FROM itunes_track
  WHERE track_type = 'File'
    AND kind LIKE '%audio file'
    AND music_path IS NOT NULL
  SQL

my %by_name;
my @singletons;

for my $track (@$tracks) {
  my $album = $track->{album} // '';
  if ($album eq '' || $album eq 'Unknown Album') {
    push @singletons, $track;
  } else {
    push @{ $by_name{ fc NFC $album } }, $track;
  }
}

$dbh->begin_work;

my $insert_album = $dbh->prepare(<<~'SQL');
  INSERT INTO itunes_album
    (artist, album, compilation, singleton, tracks, track_total, discs, disc_total)
  VALUES (?, ?, ?, ?, ?, ?, ?, ?)
  SQL

my $insert_link = $dbh->prepare(
  'INSERT INTO itunes_track_album (track_id, album_id) VALUES (?, ?)'
);

my %count = (albums => 0, compilations => 0, singletons => 0, inferred => 0);

for my $track (@singletons) {
  store_album($track->{artist} // '', '', 0, 1, [ $track ]);
  $count{singletons}++;
}

for my $name (sort keys %by_name) {
  my $group = $by_name{$name};

  if (my $why = is_compilation($group)) {
    store_album('Compilations', $group->[0]{album}, 1, 0, $group);
    $count{compilations}++;
    $count{inferred}++ if $why eq 'inferred';
    next;
  }

  my %by_artist;
  for my $track (@$group) {
    my $artist = length($track->{album_artist} // '')
               ? $track->{album_artist}
               : ($track->{artist} // '');
    push @{ $by_artist{ fc NFC $artist } }, $track;
  }

  for my $key (sort keys %by_artist) {
    my $part = $by_artist{$key};
    my $artist = length($part->[0]{album_artist} // '')
               ? $part->[0]{album_artist}
               : ($part->[0]{artist} // '');
    store_album($artist, $part->[0]{album}, 0, 0, $part);
  }
}

$dbh->commit;

$count{albums} = $dbh->selectrow_array('SELECT COUNT(*) FROM itunes_album');

printf "%-13s %6d\n", $_, $count{$_} for qw(albums compilations inferred singletons);

=head1 ROUTINES

=head2 is_compilation

  my $why = is_compilation(\@tracks);

Returns false if the tracks sharing an album name are not one compilation,
C<"flagged"> if the compilation flag says they are, or C<"inferred"> if the
shape of the group says so despite the flag.

=cut

sub is_compilation ($group) {
  my $flagged = grep {; $_->{compilation} } @$group;
  return 'flagged' if $flagged > @$group / 2;

  my $distinct = numbers_distinct($group);
  return 'flagged' if $flagged && $distinct;

  my %artists = map {; (fc NFC($_->{artist} // '')) => 1 } @$group;
  my $album_artists = grep {; length($_->{album_artist} // '') } @$group;

  return 'inferred' if keys %artists >= 3 && ! $album_artists && $distinct;
  return;
}

sub numbers_distinct ($group) {
  my %seen;
  for my $track (@$group) {
    return 0 unless defined $track->{track_number};
    my $key = join '-', ($track->{disc_number} // 1), $track->{track_number};
    return 0 if $seen{$key}++;
  }
  return 1;
}

sub store_album ($artist, $album, $compilation, $singleton, $tracks) {
  my (%discs, $track_total, $disc_total);
  for my $track (@$tracks) {
    my $disc = $track->{disc_number} // 1;
    $discs{$disc} = $track->{track_count}
      if defined $track->{track_count}
      && (! defined $discs{$disc} || $track->{track_count} > $discs{$disc});
    $discs{$disc} //= undef;
    $disc_total = $track->{disc_count}
      if defined $track->{disc_count}
      && (! defined $disc_total || $track->{disc_count} > $disc_total);
  }

  # The album's expected track total is the sum of its discs' track counts,
  # but only if every disc we saw has one. -- claude, 2026-10-14
  $track_total = (grep {; ! defined } values %discs)
               ? undef
               : do { my $t = 0; $t += $_ for values %discs; $t };

  $insert_album->execute(
    $artist, $album, $compilation, $singleton,
    scalar @$tracks, $track_total, scalar keys %discs, $disc_total,
  );

  my $album_id = $dbh->last_insert_id;
  $insert_link->execute($_->{track_id}, $album_id) for @$tracks;
}
