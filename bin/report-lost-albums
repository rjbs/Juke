#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;

binmode STDOUT, ":encoding(UTF-8)";

=head1 NAME

report-lost-albums - list the catalog's albums of which no track survives

=head1 SYNOPSIS

  report-lost-albums --db catalog.sqlite > lost-albums.csv

=head1 DESCRIPTION

The 2014 loss fell mostly by directory, so most of the tracks that went
belonged to albums that went whole.  Juke's import builds an album only
where some file of it survived, so those albums leave no trace there; this
lists them from the catalog instead, for deciding what to do about them.

An album is lost when none of its audio tracks has a file in any inventoried
library.  Albums are grouped by album artist (or artist) and title, as the
catalog has them.  Prints CSV, one album per line, most played first:

  artist, album, year, tracks, rated, avg_rating, avg_plays

C<avg_rating> is in stars, over the tracks that had a rating; C<rated> is
how many did.  C<avg_plays> is over every track.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s', 'the catalog database', { required => 1 } ],
  [],
  [ 'help', 'print usage and exit', { shortcircuit => 1 } ],
);
print($usage->text), exit if $opt->help;

my $dbh = DBI->connect("dbi:SQLite:dbname=" . $opt->db, undef, undef, { RaiseError => 1, sqlite_unicode => 1 });

my $rows = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} });
  WITH audio AS (
    SELECT track_id, coalesce(nullif(album_artist, ''), artist) AS artist, album, year,
           rating, play_count
    FROM itunes_track
    WHERE track_type = 'File' AND kind LIKE '%audio%' AND album IS NOT NULL AND album != ''
  ),
  per_album AS (
    SELECT artist, album, min(year) AS year, count(*) AS tracks,
           sum(EXISTS (SELECT 1 FROM itunes_track_file f WHERE f.track_id = audio.track_id)) AS found,
           sum(rating > 0) AS rated,
           sum(CASE WHEN rating > 0 THEN rating ELSE 0 END) AS rating_sum,
           sum(coalesce(play_count, 0)) AS plays
    FROM audio GROUP BY artist, album
  )
  SELECT * FROM per_album WHERE found = 0
  ORDER BY plays * 1.0 / tracks DESC, artist, album
  SQL

sub csv (@fields) {
  return join ',', map {; my $f = $_ // ''; $f =~ /[",\n]/ ? '"' . ($f =~ s/"/""/gr) . '"' : $f } @fields;
}

say csv(qw(artist album year tracks rated avg_rating avg_plays));
for my $r (@$rows) {
  say csv(
    $r->{artist}, $r->{album}, $r->{year}, $r->{tracks}, $r->{rated},
    $r->{rated} ? sprintf('%.1f', $r->{rating_sum} / $r->{rated} / 20) : '',
    sprintf('%.1f', $r->{plays} / $r->{tracks}),
  );
}
