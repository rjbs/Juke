#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;
use Unicode::Normalize qw(NFC);

=head1 NAME

match-tracks - link catalog tracks from the iTunes XML to files on disk

=head1 SYNOPSIS

  match-tracks --db catalog.sqlite --library mine
  match-tracks --db catalog.sqlite --library jcap

=head1 DESCRIPTION

For every audio track in C<itunes_track>, tries to find the file in the
named library that is that track, and records the result in
C<itunes_track_file>.  Each track gets at most one file per library.

Matching happens in passes, and a track matched by an earlier pass is not
considered by later ones:

=over

=item path

The track's path relative to the iTunes music folder equals the file's path
relative to the library root.  A leading C<Music/> is ignored on both sides,
because iTunes moved files in and out of that directory on its own.

=item tags

Artist, album, title and track number all match after normalization.  If
several files match, the one whose size matches the catalog's wins, then
any one of them.

=item tags-loose

Artist, album and title match, ignoring track number.

=back

Normalization is NFC, case folding, and whitespace collapsing.  It does not
try to be clever about punctuation.

The table is cleared for the named library before each run.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s',      'the SQLite catalog',           { required => 1 } ],
  [ 'library=s', 'which inventoried tree to match against', { required => 1 } ],
  [],
  [ 'help',      'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

$dbh->do(<<~'SQL');
  CREATE TABLE IF NOT EXISTS itunes_track_file (
    track_id INTEGER NOT NULL REFERENCES itunes_track (track_id),
    library  TEXT    NOT NULL,
    file_id  INTEGER NOT NULL REFERENCES file (file_id),
    method   TEXT    NOT NULL,
    PRIMARY KEY (track_id, library)
  )
  SQL

$dbh->do('CREATE INDEX IF NOT EXISTS itunes_track_file_file ON itunes_track_file (file_id)');

$dbh->begin_work;
$dbh->do('DELETE FROM itunes_track_file WHERE library = ?', undef, $opt->library);

my $tracks = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} });
  SELECT track_id, music_path, size, artist, album, name, track_number
  FROM itunes_track
  WHERE track_type = 'File'
    AND kind LIKE '%audio file'
    AND music_path IS NOT NULL
  SQL

my $files = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} }, $opt->library);
  SELECT file_id, rel_path, size, artist, album, title, track_number
  FROM file
  WHERE library = ? AND is_audio = 1
  SQL

my $insert = $dbh->prepare(
  'INSERT INTO itunes_track_file (track_id, library, file_id, method) VALUES (?, ?, ?, ?)'
);

my %by_path;
my %by_tags;
my %by_loose_tags;

for my $file (@$files) {
  push @{ $by_path{ norm_path($file->{rel_path}) } }, $file;
  push @{ $by_tags{ tag_key($file, 'title', 1) } }, $file;
  push @{ $by_loose_tags{ tag_key($file, 'title', 0) } }, $file;
}

my %count;
my @unmatched;

for my $track (@$tracks) {
  my $file = pick_file($track, $by_path{ norm_path($track->{music_path}) });
  my $method = 'path';

  if (! $file) {
    $file   = pick_file($track, $by_tags{ tag_key($track, 'name', 1) });
    $method = 'tags';
  }

  if (! $file) {
    $file   = pick_file($track, $by_loose_tags{ tag_key($track, 'name', 0) });
    $method = 'tags-loose';
  }

  if (! $file) {
    push @unmatched, $track;
    next;
  }

  $insert->execute($track->{track_id}, $opt->library, $file->{file_id}, $method);
  $count{$method}++;
}

$dbh->commit;

printf "%-11s %6d\n", $_, $count{$_} // 0 for qw(path tags tags-loose);
printf "%-11s %6d\n", 'unmatched', scalar @unmatched;

=head1 ROUTINES

=cut

sub norm_path ($path) {
  $path = NFC($path);
  $path =~ s{\AMusic/}{};
  return fc $path;
}

sub norm_text ($text) {
  return '' unless defined $text;
  $text = NFC($text);
  $text =~ s/\s+/ /g;
  $text =~ s/\A | \z//g;
  return fc $text;
}

# The catalog calls the title "name" and the inventory calls it "title";
# the caller says which.  With $with_number, the track number is part of
# the key. -- claude, 2026-10-13
sub tag_key ($row, $title_field, $with_number) {
  my $number = $with_number ? ($row->{track_number} // '') : '';

  return join "\0",
    norm_text($row->{artist}),
    norm_text($row->{album}),
    norm_text($row->{$title_field}),
    $number;
}

sub pick_file ($track, $candidates) {
  return undef unless $candidates && @$candidates;
  return $candidates->[0] if @$candidates == 1;

  my ($same_size) = grep {; $_->{size} == $track->{size} } @$candidates;
  return $same_size // $candidates->[0];
}
