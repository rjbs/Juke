#!/usr/bin/env perl
use v5.36;

use DBI;
use FindBin;
use Getopt::Long::Descriptive;
use Unicode::Normalize qw(NFC);

use lib "$FindBin::Bin/../lib";
use Juke::Catalog qw(ensure_views);
use Juke::Names qw(norm_text album_key albums_alike album_keys_alike);

=head1 NAME

match-tracks - link catalog tracks from the iTunes XML to files on disk

=head1 SYNOPSIS

  match-tracks --db catalog.sqlite --library mine
  match-tracks --db catalog.sqlite --library jcap

=head1 DESCRIPTION

For every audio track in the catalog, tries to find the file in the named
library that is that track, and records the result in C<itunes_track_file>.
Each track gets at most one file per library, and each file at most one
track.  Duplicate catalog listings of one file are left out; see
L<Juke::Catalog>.

Matching happens in passes, and a track matched by an earlier pass is not
considered by later ones:

=over

=item size

The file is exactly as many bytes as the catalog recorded, and its duration
is within two seconds.  An exact size match is near proof that these are
the same bytes, so this outranks the path: a file that was moved or renamed
but never retagged is found here, and a re-rip that took over the original
path is not mistaken for the original.

=item path

The track's path relative to the iTunes music folder equals the file's path
relative to the library root.  A leading C<Music/> is ignored on both sides,
because iTunes moved files in and out of that directory on its own.

=item tags

Artist, album, title and track number all match after normalization.  If
several files match, the one whose size matches the catalog's wins, then
any one of them.

=item tags-loose

Artist, album and title match, ignoring track number.

=item album-number

Album, disc number and track number match and the durations are within two
seconds, ignoring artist and title.  A re-rip whose titles were spelled
differently, or whose filenames iTunes truncated, lands here.

=item album-number-loose

As C<album-number>, but the album names need only be alike, as
C<title-duration> judges it.  A re-rip filed under "New Coat of Paint -
Songs of Tom Waits" finds the catalog's "New Coat Of Paint" here even
where the artist was spelled differently.

Position and length alone are weak evidence, so this pass is believed
only where it and the passes before it together account for at least half
of the files in the disc-album it is claiming from.  Three Misfits tracks
that sit in the same positions and run the same lengths as Cat Stevens
tracks in another "Box Set" are a coincidence; fourteen tracks of a
renamed re-rip are not.

=item title-duration

Artist and title match, the durations are within two seconds, and the album
names are alike once punctuation and disc markers are stripped, or the file
has no album at all.  This catches re-rips filed under a renamed album
without taking the same recording on some other album as a stand-in.

=back

Normalization is NFC, case folding, and whitespace collapsing.  It does not
try to be clever about punctuation.

The table is cleared for the named library before each run.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s',      'the SQLite catalog',           { required => 1 } ],
  [ 'library=s', 'which inventoried tree to match against', { required => 1 } ],
  [],
  [ 'help',      'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

$dbh->do(<<~'SQL');
  CREATE TABLE IF NOT EXISTS itunes_track_file (
    track_id INTEGER NOT NULL REFERENCES itunes_track (track_id),
    library  TEXT    NOT NULL,
    file_id  INTEGER NOT NULL REFERENCES file (file_id),
    method   TEXT    NOT NULL,
    PRIMARY KEY (track_id, library)
  )
  SQL

$dbh->do('CREATE INDEX IF NOT EXISTS itunes_track_file_file ON itunes_track_file (file_id)');

ensure_views($dbh);

$dbh->begin_work;
$dbh->do('DELETE FROM itunes_track_file WHERE library = ?', undef, $opt->library);

my $tracks = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} });
  SELECT track_id, music_path, size, artist, album, name, track_number,
         disc_number, total_time
  FROM itunes_audio_track
  SQL

my $files = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} }, $opt->library);
  SELECT file_id, rel_path, size, artist, album, title, track_number,
         disc_number, duration_ms
  FROM file
  WHERE library = ? AND is_audio = 1
  SQL

$_->{album_key} = album_key($_->{album}) for @$tracks, @$files;

my %disc_album_size;
$disc_album_size{ disc_album_key($_) }++ for @$files;

my $insert = $dbh->prepare(
  'INSERT INTO itunes_track_file (track_id, library, file_id, method) VALUES (?, ?, ?, ?)'
);

# Each pass is a way of turning a track or a file into a key; files are
# indexed by that key once, then each still-unmatched track looks itself
# up.  A pass may also filter the candidates it finds. -- claude, 2026-10-14
my @PASSES = (
  {
    method   => 'size',
    file_key => sub ($f) { $f->{size} },
    track_key => sub ($t) { $t->{size} },
    filter   => sub ($t, $f) { duration_close($t, $f) },
  },
  {
    method   => 'path',
    file_key => sub ($f) { norm_path($f->{rel_path}) },
    track_key => sub ($t) { norm_path($t->{music_path}) },
  },
  {
    method   => 'tags',
    file_key => sub ($f) { tag_key($f, 'title', 1) },
    track_key => sub ($t) { tag_key($t, 'name', 1) },
  },
  {
    method   => 'tags-loose',
    file_key => sub ($f) { tag_key($f, 'title', 0) },
    track_key => sub ($t) { tag_key($t, 'name', 0) },
  },
  {
    method   => 'album-number',
    file_key => sub ($f) { album_number_key($f) },
    track_key => sub ($t) { album_number_key($t) },
    filter   => sub ($t, $f) { duration_close($t, $f) },
  },
  {
    method   => 'album-number-loose',
    file_key => sub ($f) { position_duration_keys($f) },
    track_key => sub ($t) { position_duration_keys($t) },
    filter   => sub ($t, $f) {
      duration_close($t, $f) && album_keys_alike($t->{album_key}, $f->{album_key})
    },
    prune    => \&prune_by_album_majority,
  },
  {
    method   => 'title-duration',
    file_key => sub ($f) { artist_title_key($f, 'title') },
    track_key => sub ($t) { artist_title_key($t, 'name') },
    filter   => sub ($t, $f) { duration_close($t, $f) && album_alike_or_absent($t, $f) },
  },
);

for my $pass (@PASSES) {
  my %index;
  for my $file (@$files) {
    for my $key ($pass->{file_key}->($file)) {
      push @{ $index{$key} }, $file if defined $key;
    }
  }
  $pass->{index} = \%index;
}

my %count;
my %taken;
my @claimed;
my @unmatched = @$tracks;

# Passes run in order over every still-unmatched track, so a strong pass
# claims its files before a weak one can, and a file is claimed by at most
# one track.  A pass with a prune routine gets to reconsider its claims as
# a set, in light of everything claimed so far, before they are kept.
# -- claude, 2026-10-14
for my $pass (@PASSES) {
  my @still;
  my @found;

  for my $track (@unmatched) {
    my @keys = grep {; defined } $pass->{track_key}->($track);
    my $candidates = @keys
                   ? [ map {; @{ $pass->{index}{$_} // [] } } @keys ]
                   : undef;

    if ($candidates) {
      $candidates = [
        grep {; ! $taken{ $_->{file_id} } }
        grep {; ! $pass->{filter} || $pass->{filter}->($track, $_) }
        @$candidates
      ];
    }

    my $file = pick_file($track, $candidates);

    if (! $file) {
      push @still, $track;
      next;
    }

    push @found, [ $track, $file ];
    $taken{ $file->{file_id} } = 1;
  }

  if ($pass->{prune}) {
    my ($keep, $drop) = $pass->{prune}->(\@found, \@claimed);
    @found = @$keep;

    for my $pair (@$drop) {
      delete $taken{ $pair->[1]{file_id} };
      push @still, $pair->[0];
    }
  }

  for my $pair (@found) {
    my ($track, $file) = @$pair;
    $insert->execute($track->{track_id}, $opt->library, $file->{file_id}, $pass->{method});
    push @claimed, $pair;
    $count{ $pass->{method} }++;
  }

  @unmatched = @still;
}

$dbh->commit;

printf "%-15s %6d\n", $_->{method}, $count{ $_->{method} } // 0 for @PASSES;
printf "%-15s %6d\n", 'unmatched', scalar @unmatched;

=head1 ROUTINES

=cut

sub norm_path ($path) {
  $path = NFC($path);
  $path =~ s{\AMusic/}{};
  return fc $path;
}

# The catalog calls the title "name" and the inventory calls it "title";
# the caller says which.  With $with_number, the track number is part of
# the key. -- claude, 2026-10-13
sub tag_key ($row, $title_field, $with_number) {
  my $number = $with_number ? ($row->{track_number} // '') : '';

  return join "\0",
    norm_text($row->{artist}),
    norm_text($row->{album}),
    norm_text($row->{$title_field}),
    $number;
}

sub album_number_key ($row) {
  return undef unless defined $row->{track_number} && length($row->{album} // '');
  return join "\0", norm_text($row->{album}), $row->{track_number}, ($row->{disc_number} // 1);
}

# A file is indexed under its position and a two-second duration bucket,
# and a track looks in its own bucket and the two beside it.  That finds
# every file within two seconds without scanning every file in the same
# position, of which there are thousands. -- claude, 2026-10-14
sub position_duration_keys ($row) {
  return () unless defined $row->{track_number};
  my $ms = $row->{total_time} // $row->{duration_ms} // return ();
  my $bucket = int($ms / 2000);
  my $base = join "\0", $row->{track_number}, ($row->{disc_number} // 1);
  return map {; "$base\0$_" } $bucket - 1, $bucket, $bucket + 1;
}

sub disc_album_key ($file) {
  return join "\0", norm_text($file->{album}), ($file->{disc_number} // 1);
}

# Claims are grouped by the catalog album (by its loose key) and the
# disc-album of the files; a group is believed if the claims in it, from
# this pass and every pass before, cover at least half the files in that
# disc-album. -- claude, 2026-10-14
sub prune_by_album_majority ($found, $claimed) {
  my %hits;

  for my $pair (@$claimed, @$found) {
    my ($track, $file) = @$pair;
    next unless album_keys_alike($track->{album_key}, $file->{album_key});
    $hits{ join "\0", $track->{album_key}, disc_album_key($file) }++;
  }

  my (@keep, @drop);

  for my $pair (@$found) {
    my ($track, $file) = @$pair;
    my $hits = $hits{ join "\0", $track->{album_key}, disc_album_key($file) };
    my $size = $disc_album_size{ disc_album_key($file) };
    push @{ $hits * 2 >= $size ? \@keep : \@drop }, $pair;
  }

  return (\@keep, \@drop);
}

sub artist_title_key ($row, $title_field) {
  return join "\0", norm_text($row->{artist}), norm_text($row->{$title_field});
}

sub album_alike_or_absent ($track, $file) {
  return 1 unless length($file->{album} // '');
  return albums_alike($track->{album}, $file->{album});
}

sub duration_close ($track, $file) {
  return 0 unless defined $track->{total_time} && defined $file->{duration_ms};
  return abs($track->{total_time} - $file->{duration_ms}) < 2000;
}

sub pick_file ($track, $candidates) {
  return undef unless $candidates && @$candidates;
  return $candidates->[0] if @$candidates == 1;

  my ($same_size) = grep {; $_->{size} == $track->{size} } @$candidates;
  return $same_size // $candidates->[0];
}
