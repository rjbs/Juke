#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;

=head1 NAME

report-incomplete - list albums the iTunes catalog never held in full

=head1 SYNOPSIS

  report-incomplete --db catalog.sqlite --library mine > incomplete-2014.tsv

=head1 DESCRIPTION

iTunes records, on each track, how many tracks its disc has and how many
discs its album has.  Comparing those against how many tracks the catalog
actually holds shows which albums were already partial when the catalog was
written, before anything was lost.

Prints one album per line, tab-separated:

  artist  album  have  expected  discs_seen  disc_count  missing_now  reason

C<have> is how many tracks the catalog holds, C<expected> the sum of each
seen disc's track count, and C<missing_now> how many of the catalog's tracks
have no file in C<--library> today.  An album appears if it is short of its
track count or short of its disc count, and C<reason> says which (C<tracks>,
C<discs>, or C<both>).  A disc-count shortfall is weak evidence on its own:
a two-disc set whose discs carry different album names, or an album named
"[Disc 2]", shows one disc of a declared two and is not missing anything.  Albums without a track count on
any track can't be judged and are left out.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s',      'the SQLite catalog',                        { required => 1 } ],
  [ 'library=s', 'the library to count present files against', { required => 1 } ],
  [],
  [ 'help',      'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

binmode STDOUT, ':encoding(UTF-8)';

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

my $rows = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} }, $opt->library);
  WITH disc AS (
    SELECT
      CASE WHEN t.compilation THEN 'Compilations'
           ELSE COALESCE(NULLIF(t.album_artist, ''), t.artist, '')
      END AS artist,
      t.album,
      COALESCE(t.disc_number, 1) AS disc,
      COUNT(*) AS have,
      MAX(t.track_count) AS expected,
      MAX(t.disc_count) AS disc_count,
      SUM(CASE WHEN m.file_id IS NULL THEN 1 ELSE 0 END) AS missing_now
    FROM itunes_track t
    LEFT JOIN itunes_track_file m ON m.track_id = t.track_id AND m.library = ?
    WHERE t.track_type = 'File'
      AND t.kind LIKE '%audio file'
      AND t.music_path IS NOT NULL
      AND COALESCE(t.album, '') NOT IN ('', 'Unknown Album')
    GROUP BY 1, 2, 3
  )
  SELECT
    artist, album,
    SUM(have) AS have,
    SUM(expected) AS expected,
    COUNT(*) AS discs_seen,
    MAX(disc_count) AS disc_count,
    SUM(missing_now) AS missing_now,
    CASE WHEN SUM(expected) IS NOT NULL AND SUM(have) < SUM(expected)
         THEN CASE WHEN MAX(disc_count) IS NOT NULL AND COUNT(*) < MAX(disc_count)
                   THEN 'both' ELSE 'tracks' END
         ELSE 'discs'
    END AS reason
  FROM disc
  GROUP BY 1, 2
  HAVING (expected IS NOT NULL AND have < expected)
      OR (disc_count IS NOT NULL AND discs_seen < disc_count)
  ORDER BY 1 COLLATE NOCASE, 2 COLLATE NOCASE
  SQL

for my $row (@$rows) {
  say join "\t",
    map {; $_ // '' }
    @{$row}{qw(artist album have expected discs_seen disc_count missing_now reason)};
}

printf STDERR "%d albums were already incomplete in the catalog\n", scalar @$rows;
