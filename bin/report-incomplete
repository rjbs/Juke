#!/usr/bin/env perl
use v5.36;

use DBI;
use Getopt::Long::Descriptive;

=head1 NAME

report-incomplete - list albums the iTunes catalog never held in full

=head1 SYNOPSIS

  report-incomplete --db catalog.sqlite --library mine > incomplete-2014.tsv

=head1 DESCRIPTION

iTunes records, on each track, how many tracks its disc has and how many
discs its album has.  Comparing those against how many tracks the catalog
actually holds shows which albums were already partial when the catalog was
written, before anything was lost.

Prints one album per line, tab-separated:

  artist  album  have  expected  discs_seen  disc_count  missing_now  reason

C<have> is how many tracks the catalog holds, C<expected> the sum of each
seen disc's track count, and C<missing_now> how many of the catalog's tracks
have no file in C<--library> today.  An album appears if it is short of its
track count or short of its disc count, and C<reason> says which (C<tracks>,
C<discs>, or C<both>).  A disc-count shortfall is weak evidence on its own:
a two-disc set whose discs carry different album names, or an album named
"[Disc 2]", shows one disc of a declared two and is not missing anything.
Albums without a track count on every disc can't be judged on tracks.
Singletons, tracks with no album name, are left out.

Albums are as C<group-albums> decided them, which must have been run first.

With C<--dispositions>, a tab-separated file of C<artist>, C<album>,
C<disposition>, C<note> is read, and any album listed in it is left out of
the report: it has been looked at and decided, whatever the decision was.

=cut

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'db=s',      'the SQLite catalog',                        { required => 1 } ],
  [ 'library=s',      'the library to count present files against', { required => 1 } ],
  [ 'dispositions=s', 'a TSV of albums already decided, to leave out' ],
  [],
  [ 'help',      'print usage and exit', { shortcircuit => 1 } ],
);

print($usage->text), exit if $opt->help;

binmode STDOUT, ':encoding(UTF-8)';

my %decided = $opt->dispositions ? read_dispositions($opt->dispositions)->%* : ();

my $dbh = DBI->connect(
  "dbi:SQLite:dbname=" . $opt->db, undef, undef,
  { RaiseError => 1, sqlite_unicode => 1 },
);

my $rows = $dbh->selectall_arrayref(<<~'SQL', { Slice => {} }, $opt->library);
  SELECT
    a.artist, a.album,
    a.tracks AS have,
    a.track_total AS expected,
    a.discs AS discs_seen,
    a.disc_total AS disc_count,
    (SELECT COUNT(*)
     FROM itunes_track_album ta
     LEFT JOIN itunes_track_file m ON m.track_id = ta.track_id AND m.library = ?
     WHERE ta.album_id = a.album_id AND m.file_id IS NULL) AS missing_now,
    CASE WHEN a.track_total IS NOT NULL AND a.tracks < a.track_total
         THEN CASE WHEN a.disc_total IS NOT NULL AND a.discs < a.disc_total
                   THEN 'both' ELSE 'tracks' END
         ELSE 'discs'
    END AS reason
  FROM itunes_album a
  WHERE a.singleton = 0
    AND ((a.track_total IS NOT NULL AND a.tracks < a.track_total)
      OR (a.disc_total IS NOT NULL AND a.discs < a.disc_total))
  ORDER BY a.artist COLLATE NOCASE, a.album COLLATE NOCASE
  SQL

my @undecided = grep {; ! $decided{ fc "$_->{artist}\t$_->{album}" } } @$rows;

for my $row (@undecided) {
  say join "\t",
    map {; $_ // '' }
    @{$row}{qw(artist album have expected discs_seen disc_count missing_now reason)};
}

printf STDERR "%d albums were already incomplete in the catalog, %d of them not yet decided\n",
  scalar @$rows, scalar @undecided;

sub read_dispositions ($path) {
  open my $fh, '<:encoding(UTF-8)', $path or die "can't read $path: $!";
  my $header = <$fh>;

  my %decided;
  while (my $line = <$fh>) {
    chomp $line;
    my ($artist, $album, $disposition) = split /\t/, $line;
    $decided{ fc "$artist\t$album" } = $disposition;
  }

  return \%decided;
}
