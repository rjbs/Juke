#!/usr/bin/env perl
use v5.36;

# bin/install: build the app in Release and install it, without Xcode's
# Run and without TestFlight.  Run from apple/:
#
#   bin/install                       # the Mac app, into ~/Applications
#   bin/install --phone               # the iOS app, onto the paired iPhone
#   bin/install --phone --device NAME # onto this device, by name or id
#
# This builds with xcodebuild, so it doesn't mind Jinx being open in
# Xcode, and it builds into its own derived data, away from Xcode's.
# Signing is automatic and for development, which is enough for a Mac
# app that never leaves this one, and for a device already used for
# development.
#
# The build number is the count of commits on HEAD, as bin/release has
# it, but the working tree needn't be clean: this is for trying things.

use File::Path qw(remove_tree);
use File::Temp qw(tempfile);
use Getopt::Long::Descriptive;
use JSON::PP;

my ($opt, $usage) = describe_options(
  '%c %o',
  [ 'phone',    'install on an iPhone instead of this Mac' ],
  [ 'device=s', 'the device to install on, by name or id (default: the one physical iPhone)' ],
  [],
  [ 'help|h', 'show this help', { shortcircuit => 1 } ],
);
print($usage->text), exit if $opt->help;

-e 'project.yml' or die "run this from apple/\n";

# Exporting copies files with rsync, partly as "rsync" from PATH and partly
# as /usr/bin/rsync; see bin/release.  A plain build may not, but it costs
# nothing to be safe.  -- claude, 2026-11-04
$ENV{PATH} = "/usr/bin:/bin:/usr/sbin:/sbin:$ENV{PATH}";

chomp(my $build = `git rev-list --count HEAD`);
$build =~ /\A[0-9]+\z/ or die "couldn't count commits\n";

my $derived = 'build/install';

if ($opt->phone) {
  my $device = find_device($opt->device);
  build('generic/platform=iOS');
  run('xcrun', 'devicectl', 'device', 'install', 'app', '--device', $device->{id},
      "$derived/Build/Products/Release-iphoneos/Juke.app");
  say "installed build $build on $device->{name}";
} else {
  my $target = "$ENV{HOME}/Applications/Juke.app";
  check_not_running($target);
  build('platform=macOS');

  # The check is made again just before the copy, since a build takes long
  # enough to have started the app in the meantime.  It's still a race,
  # only a shorter one.  -- claude, 2026-11-04
  check_not_running($target);
  remove_tree($target);
  run('ditto', "$derived/Build/Products/Release/Juke.app", $target);
  say "installed build $build as $target";
}

sub build ($destination) {
  run('xcodegen', '-q');
  run(
    'xcodebuild', 'build', '-quiet',
    '-project', 'Juke.xcodeproj',
    '-scheme', 'Juke',
    '-configuration', 'Release',
    '-destination', $destination,
    '-derivedDataPath', $derived,
    '-allowProvisioningUpdates',
    "CURRENT_PROJECT_VERSION=$build",
  );
}

# check_not_running dies if the app at $app is running, since replacing a
# running app's bundle leaves it reading files out from under itself.
sub check_not_running ($app) {
  my $exe = "$app/Contents/MacOS/Juke";
  my @running = grep { m{\A\s*\d+\s+\Q$exe\E(\s|\z)} } `ps -axo pid=,command=`;
  return unless @running;
  my @pids = map { /(\d+)/ } @running;
  die "$app is running (pid @pids); quit it first\n";
}

# find_device returns the paired device named or identified by $wanted,
# or with no $wanted, the one physical iPhone, as { id, name }.
sub find_device ($wanted) {
  my (undef, $json) = tempfile(UNLINK => 1);
  system('xcrun', 'devicectl', 'list', 'devices', '--quiet', '--json-output', $json) == 0
    or die "couldn't list devices\n";
  my $list = do { local (@ARGV, $/) = $json; decode_json(<>) };

  my @devices =
    map {; { id => $_->{identifier}, name => $_->{deviceProperties}{name}, type => $_->{hardwareProperties}{deviceType} // '' } }
    grep { ($_->{hardwareProperties}{reality} // '') ne 'simulated' }
    $list->{result}{devices}->@*;

  my @found = defined $wanted
    ? grep { $_->{name} eq $wanted || $_->{id} eq $wanted } @devices
    : grep { $_->{type} eq 'iPhone' } @devices;
  return $found[0] if @found == 1;

  my $known = join q{}, map { "  $_->{name} ($_->{type}, $_->{id})\n" } @devices;
  die defined $wanted
    ? "no single device named $wanted; there are:\n$known"
    : "not exactly one iPhone; name one with --device:\n$known";
}

sub run (@command) {
  say "+ @command";
  system(@command) == 0 or die "failed: @command\n";
}
