#!/usr/bin/env perl
use v5.36;

# Builds the app icon set from Art/icon.png.  The artwork is drawn to the
# icon's own rounded-square shape, so it's trimmed of its margin and
# stretched to fill the whole icon, which the system then clips.  What it
# leaves transparent -- its corners, which are a little rounder than the
# system's, the gaps between tubes, and the disc's hole -- becomes black:
# an icon can't be transparent, and black reads as shadow and as a hole.
# Needs ImageMagick.  Run from apple/.  -- claude, 2026-10-26

my $source = 'Art/icon.png';
my $set    = 'App/Assets.xcassets/AppIcon.appiconset';
my $color  = q{black};

my $full = "$set/icon-1024.png";

# The artwork's edges, found from its alpha alone.  -trim compares colors,
# and transparent pixels needn't share one, so it left uneven margins and
# the art off center.  The threshold passes over faint wisps of
# antialiasing.  -- claude, 2026-10-28
chomp(my $bounds = `magick $source -alpha extract -threshold 25% -format %@ info:`);
$bounds =~ /\A[0-9]+x[0-9]+\+[0-9]+\+[0-9]+\z/ or die "couldn't find the artwork's edges\n";

system(
  'magick', '-size', '1024x1024', "xc:$color",
  '(', $source, '-crop', $bounds, '+repage', '-resize', '1024x1024!', ')',
  '-composite',
  '-alpha', 'off', '-strip',
  $full,
) == 0 or die "magick failed on $full\n";

for my $size (16, 32, 64, 128, 256, 512) {
  system('magick', $full, '-resize', "${size}x$size", '-strip', "$set/icon-$size.png") == 0
    or die "magick failed at $size\n";
}
